+// Camoufox: Realistic sensor simulation for mobile device emulation.
+//
+// Physics model:
+//   - Gaussian noise via Box-Muller transform (real MEMS noise is Gaussian)
+//   - Bias random walk (Brownian motion drift) per axis
+//   - Physiological hand tremor at 6-15 Hz with peak at ~8 Hz
+//   - Gravity vector correctly distributed across axes from phone orientation
+//   - Cross-sensor consistency: accel, gyro, orientation from same physical state
+//   - 60 Hz sampling rate matching real browser behavior
+//   - Noise magnitudes matched to real device specs
+class CamoufoxSensorSimulator final : public nsITimerCallback, public nsINamed {
+ public:
+  NS_DECL_ISUPPORTS
+
+  explicit CamoufoxSensorSimulator(nsDeviceSensors* aTarget)
+      : mTarget(aTarget), mTick(0) {
+    uint64_t seed = static_cast<uint64_t>(PR_Now());
+    mRngState[0] = static_cast<uint32_t>(seed);
+    mRngState[1] = static_cast<uint32_t>(seed >> 17) ^ 0xDEADBEEF;
+
+    // Per-session calibration bias (unique per browser session, stable)
+    mAccelBias[0] = Gaussian() * 0.05;
+    mAccelBias[1] = Gaussian() * 0.05;
+    mAccelBias[2] = Gaussian() * 0.05;
+    mGyroBias[0] = Gaussian() * 0.0005;
+    mGyroBias[1] = Gaussian() * 0.0005;
+    mGyroBias[2] = Gaussian() * 0.0005;
+
+    mAccelDrift[0] = mAccelDrift[1] = mAccelDrift[2] = 0.0;
+    mGyroDrift[0] = mGyroDrift[1] = mGyroDrift[2] = 0.0;
+
+    // Phone orientation: nearly upright, slight tilt (hand-held)
+    mPitch = 1.396 + Gaussian() * 0.05;  // ~80 degrees
+    mRoll = 0.035 + Gaussian() * 0.02;   // ~2 degrees
+    mYaw = Gaussian() * M_PI;
+  }
+
+  NS_IMETHOD Notify(nsITimer* aTimer) override {
+    using namespace mozilla::hal;
+    double t = mTick * 0.016667;  // 60 Hz sampling
+
+    // Slow orientation drift (simulates hand micro-adjustments)
+    mPitch += Gaussian() * 0.0003;
+    mRoll += Gaussian() * 0.0004;
+    mYaw += Gaussian() * 0.0002;
+
+    if (mPitch < 1.047) mPitch = 1.047;
+    if (mPitch > 1.745) mPitch = 1.745;
+    if (mRoll < -0.175) mRoll = -0.175;
+    if (mRoll > 0.175) mRoll = 0.175;
+
+    // Bias random walk (Brownian motion)
+    double bwAccel = 2.58e-5;
+    double bwGyro = 3.33e-6;
+    for (int i = 0; i < 3; i++) {
+      mAccelDrift[i] += Gaussian() * bwAccel;
+      mGyroDrift[i] += Gaussian() * bwGyro;
+    }
+
+    // Physiological hand tremor (6-15 Hz, peak at ~8 Hz)
+    double tremor[3];
+    for (int i = 0; i < 3; i++) {
+      double phase = t * 2.0 * M_PI;
+      tremor[i] = 0.012 * sin(phase * 8.2 + i * 1.1 + Gaussian() * 0.1) +
+                  0.006 * sin(phase * 6.5 + i * 2.3 + Gaussian() * 0.08) +
+                  0.004 * sin(phase * 11.7 + i * 0.7 + Gaussian() * 0.12) +
+                  0.003 * sin(phase * 14.3 + i * 1.9 + Gaussian() * 0.15);
+    }
+
+    // Gravity vector from orientation
+    double sp = sin(mPitch), cp = cos(mPitch);
+    double sr = sin(mRoll), cr = cos(mRoll);
+    double gx = -9.81 * sp * sr;
+    double gy = 9.81 * cp;
+    double gz = -9.81 * sp * cr;
+
+    // ACCELERATION (with gravity)
+    {
+      SensorData sd;
+      sd.sensor() =
+          static_cast<SensorType>(nsIDeviceSensorData::TYPE_ACCELERATION);
+      sd.timestamp() = PR_Now();
+      sd.values().AppendElement(static_cast<float>(
+          gx + mAccelBias[0] + mAccelDrift[0] + tremor[0] + Gaussian() * 0.008));
+      sd.values().AppendElement(static_cast<float>(
+          gy + mAccelBias[1] + mAccelDrift[1] + tremor[1] + Gaussian() * 0.008));
+      sd.values().AppendElement(static_cast<float>(
+          gz + mAccelBias[2] + mAccelDrift[2] + tremor[2] + Gaussian() * 0.008));
+      mTarget->Notify(sd);
+    }
+
+    // LINEAR ACCELERATION (gravity removed)
+    {
+      SensorData sd;
+      sd.sensor() = static_cast<SensorType>(
+          nsIDeviceSensorData::TYPE_LINEAR_ACCELERATION);
+      sd.timestamp() = PR_Now();
+      sd.values().AppendElement(
+          static_cast<float>(tremor[0] + Gaussian() * 0.005));
+      sd.values().AppendElement(
+          static_cast<float>(tremor[1] + Gaussian() * 0.005));
+      sd.values().AppendElement(
+          static_cast<float>(tremor[2] + Gaussian() * 0.005));
+      mTarget->Notify(sd);
+    }
+
+    // GYROSCOPE
+    {
+      SensorData sd;
+      sd.sensor() =
+          static_cast<SensorType>(nsIDeviceSensorData::TYPE_GYROSCOPE);
+      sd.timestamp() = PR_Now();
+      sd.values().AppendElement(static_cast<float>(
+          mGyroBias[0] + mGyroDrift[0] + tremor[0] * 0.08 + Gaussian() * 0.001));
+      sd.values().AppendElement(static_cast<float>(
+          mGyroBias[1] + mGyroDrift[1] + tremor[1] * 0.08 + Gaussian() * 0.001));
+      sd.values().AppendElement(static_cast<float>(
+          mGyroBias[2] + mGyroDrift[2] + tremor[2] * 0.08 + Gaussian() * 0.001));
+      mTarget->Notify(sd);
+    }
+
+    // ORIENTATION (degrees)
+    {
+      SensorData sd;
+      sd.sensor() =
+          static_cast<SensorType>(nsIDeviceSensorData::TYPE_ORIENTATION);
+      sd.timestamp() = PR_Now();
+      double alpha = fmod(mYaw * 180.0 / M_PI + 360.0, 360.0);
+      double beta = mPitch * 180.0 / M_PI + Gaussian() * 0.3;
+      double gamma = mRoll * 180.0 / M_PI + Gaussian() * 0.3;
+      sd.values().AppendElement(static_cast<float>(alpha));
+      sd.values().AppendElement(static_cast<float>(beta));
+      sd.values().AppendElement(static_cast<float>(gamma));
+      mTarget->Notify(sd);
+    }
+
+    mTick++;
+    return NS_OK;
+  }
+
+  NS_IMETHOD GetName(nsACString& aName) override {
+    aName.AssignLiteral("CamoufoxSensorSimulator");
+    return NS_OK;
+  }
+
+ private:
+  ~CamoufoxSensorSimulator() = default;
+
+  // xorshift64 PRNG
+  uint32_t Rand32() {
+    uint32_t s = mRngState[0];
+    uint32_t t = mRngState[1];
+    mRngState[0] = t;
+    s ^= s << 11;
+    s ^= s >> 8;
+    mRngState[1] = s ^ t ^ (t >> 19);
+    return mRngState[1];
+  }
+
+  // Box-Muller transform: uniform → Gaussian (mean=0, sd=1)
+  double Gaussian() {
+    double u1 = (Rand32() + 1.0) / 4294967297.0;
+    double u2 = (Rand32() + 1.0) / 4294967297.0;
+    return sqrt(-2.0 * log(u1)) * cos(2.0 * M_PI * u2);
+  }
+
+  RefPtr<nsDeviceSensors> mTarget;
+  uint64_t mTick;
+  uint32_t mRngState[2];
+  double mAccelBias[3];
+  double mGyroBias[3];
+  double mAccelDrift[3];
+  double mGyroDrift[3];
+  double mPitch;
+  double mRoll;
+  double mYaw;
+};
+
+NS_IMPL_ISUPPORTS(CamoufoxSensorSimulator, nsITimerCallback, nsINamed)
+
 NS_IMETHODIMP nsDeviceSensors::AddWindowListener(uint32_t aType,
                                                  nsIDOMWindow* aWindow) {
   if (!IsSensorAllowedByPref(aType, aWindow)) return NS_OK;
@@ -160,6 +343,23 @@ NS_IMETHODIMP nsDeviceSensors::AddWindowListener(uint32_t aType,
 
   mWindowListeners[aType]->AppendElement(aWindow);
 
+  // Camoufox: start unified sensor simulator when sensors:enabled is true.
+  // One simulator drives all four sensor types in lockstep for cross-sensor
+  // consistency (gravity, tremor, and orientation from same physical state).
+  if (MaskConfig::CheckBool("sensors:enabled") &&
+      mCamoufoxSensorTimers.IsEmpty()) {
+    if (aType == nsIDeviceSensorData::TYPE_ACCELERATION ||
+        aType == nsIDeviceSensorData::TYPE_LINEAR_ACCELERATION ||
+        aType == nsIDeviceSensorData::TYPE_GYROSCOPE ||
+        aType == nsIDeviceSensorData::TYPE_ORIENTATION) {
+      nsCOMPtr<nsITimer> timer;
+      RefPtr<CamoufoxSensorSimulator> sim = new CamoufoxSensorSimulator(this);
+      NS_NewTimerWithCallback(getter_AddRefs(timer), sim, 16,
+                              nsITimer::TYPE_REPEATING_SLACK);
+      mCamoufoxSensorTimers.AppendElement(timer);
+    }
+  }
+
   if (StaticPrefs::device_sensors_test_events()) {
     nsCOMPtr<nsIRunnable> event = new DeviceSensorTestEvent(this, aType);
     NS_DispatchToCurrentThread(event);
